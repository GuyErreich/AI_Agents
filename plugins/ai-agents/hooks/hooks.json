{
  "version": 1,
  "hooks": {
    "subagentStart": [
      {
        "command": "bash ./hooks/run-python.sh review_loop_budget.py",
        "matcher": "pr-reviewer|pr-fixer"
      }
    ],
    "subagentStop": [
      {
        "command": "bash ./hooks/run-python.sh review_loop_round.py",
        "matcher": "pr-reviewer|pr-fixer",
        "loop_limit": 3
      }
    ],
    "beforeShellExecution": [
      {
        "command": "bash ./hooks/run-python.sh review_loop_git_guard.py",
        "matcher": "git",
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": "bash ./hooks/run-python.sh npm_dep_gate.py"
      }
    ],
    "afterShellExecution": [
      {
        "command": "bash ./hooks/run-python.sh npm_dep_gate.py",
        "matcher": "(npm\\s+(install|i\\b|ci|update|uninstall|remove|audit|upgrade)|uv\\s+(add|remove|lock|sync|audit|pip\\s+install|pip\\s+uninstall))"
      }
    ],
    "stop": [
      {
        "command": "bash ./hooks/run-python.sh npm_dep_gate.py",
        "loop_limit": 2
      }
    ]
  }
}
